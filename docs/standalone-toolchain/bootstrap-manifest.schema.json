{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techwithkaushik/c-cpp-ide/blob/architecture/termux-integration/docs/standalone-toolchain/bootstrap-manifest.schema.json",
  "title": "C/C++ IDE standalone bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._+-]+$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "abi",
          "downloadUrl",
          "sha256",
          "compressedSizeBytes",
          "maximumExpandedBytes"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "abi": {
            "enum": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ]
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "compressedSizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "maximumExpandedBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1073741824
          }
        }
      }
    }
  }
}
